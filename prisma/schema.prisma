// AI Wedding Invitation Studio — database schema (MongoDB)
// Run `npx prisma db push` after setting DATABASE_URL to apply this.
// MongoDB is schema-less — there is no `prisma migrate`, only `db push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth.js / Auth.js v5 — @auth/prisma-adapter shape)
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // set for credentials sign-up; null for OAuth-only users
  role          UserRole  @default(USER)
  // Optional (not defaulted) so existing Mongo documents without this field
  // still read fine — treat missing/null as active everywhere it's read.
  isActive      Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  invitations   Invitation[]
  subscription  Subscription?
  analyticsHits AnalyticsEvent[]

  @@map("users")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  userId               String             @unique @db.ObjectId
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Theming / template catalog (admin-managed, invitation-agnostic)
// ---------------------------------------------------------------------------

// WEBSITE themes drive the live invitation site; PDF themes drive the
// print/"Download PDF" stylesheet. Same shape (palette, fonts, section
// order) reused across both surfaces, filtered by type wherever a picker
// only wants one of them.
enum ThemeType {
  WEBSITE
  PDF
}

model Theme {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  type           ThemeType @default(WEBSITE)
  name           String
  slug           String    @unique
  description    String?
  previewImage   String?
  category       String    @default("classic") // "traditional" | "modern" | "fusion" | "minimal" | "classic"
  // Which celebration this design is written for — "wedding", "birthday",
  // "housewarming"... See src/lib/event-categories.ts. A theme only ever
  // shows up in the picker for its own category.
  eventCategory  String    @default("wedding")
  // Default copy this design ships with (headline, invitation letter, thank
  // you...), used when the couple asks for no AI copy. Shape: the
  // EventCategoryContent type. Null falls back to the category's own copy.
  content        Json?
  colorPalette   Json // { primary, secondary, accent, background, foreground }
  fontPairing    Json // { display, body, script }
  decorAssets    Json? // preset decoration config (petals, sparkles, motifs...)
  isPremium      Boolean   @default(false)
  sortOrder      Int       @default(0)
  // Envelope-open moment: admin picks "ANIMATION" (coded burst only) or
  // "VIDEO" (a short muted clip, preloaded and layered over the coded
  // burst once ready — falls back to the coded burst if it isn't ready
  // in time, so the reveal never blocks on the network). WEBSITE themes only.
  revealMode     String    @default("ANIMATION") // "ANIMATION" | "VIDEO"
  revealVideoUrl String?

  templates      Template[]
  colorways      ThemeColorway[]
  invitations    Invitation[]    @relation("InvitationWebsiteTheme")
  pdfInvitations Invitation[]    @relation("InvitationPdfTheme")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("themes")
}

// A theme is a design — layout, fonts, ornament, reveal — and a colourway is
// one of the colour schemes it ships in. "Royal" in maroon-and-gold and
// "Royal" in emerald are the same design, so they share a Theme and differ
// only here. The theme's own `colorPalette` remains its default colourway.
model ThemeColorway {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  themeId      String  @db.ObjectId
  name         String // "Maroon & Gold", "Emerald", "Blush"
  slug         String
  colorPalette Json // { primary, secondary, accent, background, foreground }
  previewImage String?
  sortOrder    Int     @default(0)

  theme       Theme        @relation(fields: [themeId], references: [id], onDelete: Cascade)
  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([themeId, slug])
  @@map("theme_colorways")
}

model Template {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String  @unique
  description  String?
  previewImage String?
  themeId      String  @db.ObjectId
  sectionOrder Json // default ordered list of SectionType strings (WEBSITE themes)
  // Multi-page PDF layout (PDF themes only): PdfTemplatePage[] — each page a
  // background image/color plus positioned, field-bound text placeholders.
  // See src/lib/validations/pdf-template.ts for the shape.
  pages        Json?
  isPremium    Boolean @default(false)

  theme       Theme        @relation(fields: [themeId], references: [id])
  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("templates")
}

// Gemini video "themes": a reusable prompt template + style/aspect ratio
// preset, admin-managed the same way website/PDF themes are.
model VideoTemplate {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String  @unique
  description     String?
  previewImage    String?
  aspectRatio     String  @default("9:16") // "9:16" | "16:9" | "1:1"
  durationSeconds Int     @default(15)
  // Prompt sent to Gemini's video model. Supports {{brideName}}, {{groomName}},
  // {{weddingDate}}, {{venueName}}, {{style}} placeholders, filled in from the
  // invitation's own captured details at generation time.
  promptTemplate  String
  styleKeywords   Json? // string[] of mood/style keywords appended to the prompt
  // "auto" resolves to the best video model the generating key can
  // actually reach; a pinned ID is still honoured when it's available.
  geminiModel     String  @default("auto")
  isPremium       Boolean @default(false)
  sortOrder       Int     @default(0)

  invitations Invitation[]
  videos      InvitationVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("video_templates")
}

model MusicTrack {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String   @unique
  artist     String?
  url        String
  durationMs Int?
  mood       String? // e.g. "romantic", "upbeat", "traditional"
  isPremium  Boolean  @default(false)
  // Auto-assigned when a couple doesn't pick a track. Optional (not defaulted)
  // so existing tracks without this field still read fine — only one track
  // should be true at a time; enforced in upsertMusicTrackAction, not here.
  isDefault  Boolean?

  invitations Invitation[]

  createdAt DateTime @default(now())

  @@map("music_tracks")
}

// ---------------------------------------------------------------------------
// Invitation (the core object the wizard/builder/renderer all operate on)
// ---------------------------------------------------------------------------

enum InvitationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InvitationLanguage {
  EN
  HI
  MR
  GU
  TA
  TE
  ES
  FR
}

model Invitation {
  id     String           @id @default(auto()) @map("_id") @db.ObjectId
  // Optional: guest invitations (created from the public "Get started" flow,
  // before any WhatsApp-verified phone is linked) have no user account.
  userId String?          @db.ObjectId
  slug   String           @unique
  status InvitationStatus @default(DRAFT)

  // Which kind of celebration this is — "wedding", "birthday", "naming"...
  // Decides what the two name slots below mean, what copy is written, and
  // what the PDF's cover says. See src/lib/event-categories.ts.
  eventCategory String @default("wedding")

  // Guest-flow ownership. `draftSecretHash` authorizes edits to an
  // unpublished guest draft (its raw value lives only in an httpOnly
  // cookie on the creator's browser). Once the owner verifies a WhatsApp
  // OTP, a PhoneLink takes over as the durable, cross-device "login".
  draftSecretHash String?
  isDemo          Boolean @default(false)

  // The two name slots. For a wedding they're the couple; for a birthday
  // they're the birthday star and whoever is hosting; for a housewarming
  // the family name and the host. `eventCategory` decides which, and how
  // they're joined when printed.
  brideName  String
  bridePhoto String?
  groomName  String
  groomPhoto String?

  // Core details
  weddingDate   DateTime
  venueName     String?
  venueAddress  String?
  googleMapsUrl String?
  customMessage String?
  language      InvitationLanguage @default(EN)
  // Culture, asked first in the wizard so the ceremony list can be
  // pre-filled with the rituals that tradition actually observes.
  religion      String?
  caste         String?
  // Asked only where an admin has switched the field on for the category —
  // see EventCategoryConfig. Optional here regardless: "required" is about
  // the form, never about a record written before the field existed.
  subCaste      String?
  // Extra text for the PDF only (e.g. a formal invitation letter) — not
  // shown on the website, bindable to a placeholder on a PDF template page.
  pdfExtraText  String?

  // Design
  themeId          String? @db.ObjectId // WEBSITE-type Theme
  templateId       String? @db.ObjectId
  // Optional PDF-type Theme override for the downloadable PDF — falls back
  // to `theme` (the website theme's palette) when unset.
  pdfThemeId       String? @db.ObjectId
  // Last video template picked/used for Gemini video generation — surfaced
  // as the default selection next time the couple regenerates one.
  videoTemplateId  String? @db.ObjectId
  // Couple's own Gemini API key (from Google AI Studio), used instead of the
  // platform's GEMINI_API_KEY when set. Never rendered back to the client —
  // forms only report whether one is configured.
  geminiApiKey     String?
  fontPairing      Json? // override of theme default, { display, body, script }
  // Which of the theme's colourways was chosen. The resolved palette is
  // copied into `colorPalette` on save, so rendering never has to know
  // colourways exist — this only records the choice for the pickers.
  colorwayId       String? @db.ObjectId
  colorPalette     Json? // resolved palette: colourway, or a manual override
  musicTrackId     String? @db.ObjectId
  customMusicUrl   String? // couple's own uploaded audio — takes priority over musicTrackId when set
  galleryAnimation String  @default("fade") // "fade" | "slide" | "zoom" | "flip" | "blur" — gallery photo reveal style
  sectionConfig    Json // [{ id, type, visible, locked, order }] — drives the drag-drop builder

  // AI + content
  aiGenerated     Boolean @default(false)
  aiGeneratedCopy Json? // { heroHeadline, heroSubline, invitationLetter, hashtags, ... }

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme         Theme?         @relation("InvitationWebsiteTheme", fields: [themeId], references: [id])
  colorway      ThemeColorway? @relation(fields: [colorwayId], references: [id])
  pdfTheme      Theme?         @relation("InvitationPdfTheme", fields: [pdfThemeId], references: [id])
  template      Template?      @relation(fields: [templateId], references: [id])
  music         MusicTrack?    @relation(fields: [musicTrackId], references: [id])
  videoTemplate VideoTemplate? @relation(fields: [videoTemplateId], references: [id])

  events          Event[]
  familyMembers   FamilyMember[]
  guests          Guest[]
  rsvps           Rsvp[]
  media           Media[]
  analyticsEvents AnalyticsEvent[]
  deployment      Deployment?
  phoneLink       PhoneLink?
  instagramLink   InstagramLink?
  videos          InvitationVideo[]
  orderItems      OrderItem[]

  @@index([userId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Guest publish flow
// ---------------------------------------------------------------------------

// Established directly at publish time (no OTP round-trip) from a phone
// number the couple provides. Both `phone` and `invitationId` are unique,
// so this is the enforcement point for "one mobile number, one invitation":
// a phone can appear in at most one row, an invitation can be linked to at
// most one phone. `editTokenHash` backs the pre-logged WhatsApp link sent
// to the owner for future edits.
model PhoneLink {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  phone         String   @unique
  invitationId  String   @unique @db.ObjectId
  editTokenHash String   @unique
  verifiedAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("phone_links")
}

model Event {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  invitationId  String   @db.ObjectId
  name          String // e.g. "Mehendi", "Haldi", "Wedding"
  date          DateTime
  time          String?
  venueName     String?
  address       String?
  googleMapsUrl String?
  dressCode     String?
  accentColor   String?
  tagline       String? // short italic line under the event name, e.g. "The groom's royal procession begins!"
  order         Int      @default(0)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("events")
}

enum FamilySide {
  BRIDE
  GROOM
}

model FamilyMember {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  invitationId String     @db.ObjectId
  side         FamilySide
  relation     String // "Father", "Mother", "Sister", ...
  name         String
  photo        String?
  order        Int        @default(0)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("family_members")
}

model Guest {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  invitationId String    @db.ObjectId
  name         String
  email        String?
  phone        String?
  group        String? // e.g. "Bride's side", "Groom's college friends"
  inviteToken  String    @unique @default(cuid())
  viewedAt     DateTime? // set the first time this guest opens their personalized link

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  rsvp       Rsvp?

  createdAt DateTime @default(now())

  @@index([invitationId])
  @@map("guests")
}

enum RsvpStatus {
  ACCEPTED
  DECLINED
  MAYBE
}

model Rsvp {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  invitationId   String     @db.ObjectId
  guestId        String?    @unique @db.ObjectId
  guestName      String
  email          String?
  phone          String?
  status         RsvpStatus
  guestCount     Int        @default(1)
  foodPreference String?
  comment        String?

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invitationId])
  @@map("rsvps")
}

enum MediaType {
  IMAGE
  VIDEO
}

model Media {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  invitationId String    @db.ObjectId
  url          String
  cloudinaryId String?
  type         MediaType @default(IMAGE)
  width        Int?
  height       Int?
  blurDataUrl  String?
  caption      String?
  order        Int       @default(0)
  isAuto       Boolean   @default(false) // filled by the "use automatic photos" fallback, not uploaded by the couple

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([invitationId])
  @@map("media")
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

enum AnalyticsEventType {
  VIEW
  SHARE
  RSVP_SUBMIT
  CLICK_MAPS
  CLICK_REGISTRY
  CLICK_INSTAGRAM
}

model AnalyticsEvent {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  invitationId String             @db.ObjectId
  userId       String?            @db.ObjectId
  type         AnalyticsEventType
  country      String?
  device       String? // "mobile" | "tablet" | "desktop"
  referrer     String?
  path         String?

  createdAt DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([invitationId])
  @@index([type])
  @@map("analytics_events")
}

// ---------------------------------------------------------------------------
// Deployment
// ---------------------------------------------------------------------------

enum DeploymentStatus {
  PENDING
  BUILDING
  DEPLOYED
  FAILED
}

model Deployment {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  invitationId    String           @unique @db.ObjectId
  status          DeploymentStatus @default(PENDING)
  url             String?
  customDomain    String?
  vercelProjectId String?
  vercelDeployId  String?
  error           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("deployments")
}

// ---------------------------------------------------------------------------
// Gemini video generation
// ---------------------------------------------------------------------------

enum VideoJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// One row per generation attempt (couples can regenerate with a different
// template), so history stays visible instead of being overwritten.
model InvitationVideo {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  invitationId      String         @db.ObjectId
  videoTemplateId   String         @db.ObjectId
  status            VideoJobStatus @default(PENDING)
  // The fully-resolved prompt sent to Gemini, built from the invitation's
  // own captured details (names, date, venue, theme colors) + the template.
  prompt            String
  videoUrl          String?
  geminiOperationId String?
  // The model the job actually ran on — not always the template's, since
  // an unreachable pinned model falls back to one the key can reach.
  geminiModel       String?
  error             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation    Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  videoTemplate VideoTemplate @relation(fields: [videoTemplateId], references: [id])

  @@index([invitationId])
  @@map("invitation_videos")
}

// ---------------------------------------------------------------------------
// Instagram comment-to-DM automation
// ---------------------------------------------------------------------------

// One automation rule per Instagram post/reel. Without a rule for the media
// a comment arrived on, the webhook does nothing — automation is opt-in per
// reel rather than replying to every "FREE" anywhere on the account.
model InstagramAutomation {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  // Instagram media ID the rule applies to, from the comment webhook's
  // value.media.id. Unique so one reel has exactly one rule.
  mediaId             String   @unique
  // Admin-facing name so reels are recognisable in the dashboard.
  label               String
  permalink           String?
  triggerWord         String
  // Reply sent on a first match. Supports {{link}} and {{username}}.
  replyMessage        String
  // Reply sent when this commenter already claimed this reel's link.
  duplicateMessage    String
  // Gate the link behind following the account. The follow check is
  // best-effort (see InstagramProfile) and fails closed: a status Instagram
  // won't resolve is treated as "not following", because it won't resolve
  // for most first-time commenters and failing open handed the link to
  // everyone. They're asked to follow and comment again instead.
  requireFollow       Boolean  @default(false)
  notFollowingMessage String?
  // Reply with the tappable opener from InstagramFlowSettings instead of the
  // link itself, so the link is only issued after the follow is confirmed on
  // a tap. The plain reply above is still what a non-flow reel sends.
  // Optional, not defaulted: this arrived after these rows existed, and
  // `db push` doesn't backfill — a required field missing from a stored
  // document makes Prisma fail the whole read. Missing means off.
  useButtonFlow       Boolean?
  isActive            Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads InstagramLead[]
  logs  InstagramCommentLog[]

  @@map("instagram_automations")
}

// Tracks which Instagram accounts have already received their access link
// for a given reel, enforcing one link per account per automation. Written
// only after the send actually succeeds.
// The Instagram equivalent of PhoneLink, and the identity spine of the
// comment-to-DM flow: it binds one Instagram account to exactly one
// invitation and backs the pre-logged /e/<token> link sent by DM. Both
// `igUserId` and `invitationId` are unique, so an Instagram account owns at
// most one invitation — which is what makes "one website, one PDF, one video
// per Instagram user" enforceable at all.
model InstagramLink {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  igUserId            String    @unique
  username            String?
  invitationId        String    @unique @db.ObjectId
  editTokenHash       String    @unique
  createdAt           DateTime  @default(now())
  // When the "your invitation is live" DM went out. Set once: publishing is
  // something people do repeatedly while tweaking, and each edit re-publish
  // should not be another message.
  publishedNotifiedAt DateTime?

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("instagram_links")
}

model InstagramLead {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  // Optional so rows created before per-reel automations still read; those
  // legacy rows simply never match a (user, automation) pair again.
  automationId String?  @db.ObjectId
  igUserId     String
  commentId    String
  link         String
  createdAt    DateTime @default(now())

  automation InstagramAutomation? @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([igUserId, automationId])
  @@map("instagram_leads")
}

enum InstagramCommentOutcome {
  REPLY_SENT
  DUPLICATE_SKIPPED
  TRIGGER_NOT_MATCHED
  NO_AUTOMATION
  AUTOMATION_INACTIVE
  // Instagram confirmed they don't follow the account.
  NOT_FOLLOWING
  // Instagram wouldn't say either way, so the followers-only gate held the
  // link back. Distinct from NOT_FOLLOWING so an admin can see whether the
  // gate is turning people away on real answers or on unresolved checks.
  FOLLOW_UNVERIFIED
  // The button flow's opener was sent; the link is delivered later, in DMs,
  // once they tap through the follow gate.
  FLOW_STARTED
  SEND_FAILED
}

// The last follower status we saw per person, as a record — not as an
// authority. Instagram has no "does X follow me" lookup for arbitrary users;
// only the messaging User Profile endpoint's is_user_follow_business answers,
// and every gate decision asks it live (see resolveFollowStatus).
//
// This row used to authorise: a positive was trusted for an hour, which was
// exactly long enough to follow, take a link, unfollow, and keep passing the
// gate on the way back. Now it only feeds the dashboard and supplies a
// username for someone who has commented before. Unresolved checks are not
// stored at all — the reply sent on one opens a conversation, which is often
// what lets the next check resolve.
model InstagramProfile {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  igUserId   String   @unique
  username   String?
  isFollower Boolean
  checkedAt  DateTime @default(now())

  @@map("instagram_profiles")
}

// Every comment the webhook processes, matched or not, so the admin
// dashboard can show what came in per reel and what was replied.
model InstagramCommentLog {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  automationId String?                 @db.ObjectId
  mediaId      String
  commentId    String
  igUserId     String?
  username     String?
  commentText  String
  outcome      InstagramCommentOutcome
  replyText    String?
  error        String?
  createdAt    DateTime                @default(now())

  automation InstagramAutomation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@index([mediaId])
  @@index([createdAt])
  // Read on every incoming comment to spot a webhook Meta re-delivered.
  // Deliberately not unique: existing rows predate the check and may repeat.
  @@index([commentId])
  @@map("instagram_comment_logs")
}

// ---------------------------------------------------------------------------
// Instagram DM automation
// ---------------------------------------------------------------------------

enum InstagramDmMatchType {
  // The whole message, trimmed, equals the keyword.
  EXACT
  // The keyword appears anywhere in the message.
  CONTAINS
  // The message opens with the keyword.
  STARTS_WITH
  // No keyword — matches anything. The deliberate catch-all, so "reply to
  // every DM" stays possible but has to be switched on rather than assumed.
  ANY
}

// One rule per kind of incoming DM. Like the per-reel comment automations,
// DM replies are opt-in: a message matching no active rule is logged for the
// dashboard and left for a human, instead of every DM getting the same
// canned answer.
model InstagramDmRule {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  label String

  matchType InstagramDmMatchType @default(CONTAINS)
  // Ignored (and stored null) when matchType is ANY.
  keyword   String?

  // Reply text. Supports {{username}}, plus {{link}} when issueLink is on.
  replyMessage     String
  // Hand the sender their invitation link, the same one the comment
  // automations issue, so a DM can carry the whole flow on its own.
  issueLink        Boolean @default(false)
  // Sent instead of replyMessage when this sender already has a link.
  duplicateMessage String?

  // Answer with the button flow's opener rather than replyMessage, so a
  // keyword DM runs the same tap-through-the-follow-gate flow a reel does.
  // Optional for the same reason as InstagramAutomation.useButtonFlow:
  // missing on a row written before it existed, and missing means off.
  startFlow Boolean?

  // Followers-only for this rule. Missing reads as *on*: a rule that issued
  // a link used to have no follow check at all, which is how non-followers
  // were getting links by DM however carefully the reels were gated, so the
  // absent value has to be the safe one. The account-wide rule in
  // InstagramFlowSettings still wins — this can only tighten it.
  requireFollow       Boolean?
  notFollowingMessage String?

  // Higher wins. Rules are compared in priority order and the first match
  // replies, so a specific keyword can be placed above a catch-all.
  priority Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs InstagramMessageLog[]

  @@map("instagram_dm_rules")
}

enum InstagramDmOutcome {
  REPLY_SENT
  DUPLICATE_REPLY_SENT
  // Button flow steps. Every tap is an inbound message, so the flow's
  // progress is readable in the DM log alongside ordinary replies.
  FLOW_STARTED
  FLOW_FOLLOW_PROMPTED
  FLOW_STILL_NOT_FOLLOWING
  FLOW_LINK_SENT
  // The link was held back: Instagram said they don't follow, or wouldn't
  // say either way. Kept apart so the dashboard shows which it was.
  NOT_FOLLOWING
  FOLLOW_UNVERIFIED
  // Nothing matched, so nothing was sent — the quiet default.
  NO_RULE_MATCHED
  DATA_DELETED
  DATA_DELETE_FAILED
  SEND_FAILED
}

// Every inbound DM the webhook processes, replied to or not, so an admin can
// see what people actually send and write rules for the messages that need
// one.
model InstagramMessageLog {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  ruleId      String?            @db.ObjectId
  // Meta's message id (mid). Optional because a payload can omit it; when
  // present it is what stops a re-delivered webhook sending a second reply.
  messageId   String?
  igUserId    String
  username    String?
  messageText String
  outcome     InstagramDmOutcome
  replyText   String?
  error       String?
  createdAt   DateTime           @default(now())

  rule InstagramDmRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([igUserId])
  @@index([createdAt])
  // Read on every inbound message to spot a webhook Meta re-delivered.
  @@index([messageId])
  @@map("instagram_message_logs")
}

// ---------------------------------------------------------------------------
// Instagram button flow
// ---------------------------------------------------------------------------

// The tap-through flow a reel comment or a keyword DM can start: an opener
// with a button, a follow gate with "Visit profile" / "I'm following", and
// the invite link only once the follow check comes back positive.
//
// One row for the whole account rather than a copy per reel: the wording is
// about *us* — our profile, our website, our link — so an admin edits it
// once and every reel that opts in with `useButtonFlow` uses it. `key` is
// unique and always "default", which is what makes the singleton a
// constraint rather than a convention.
//
// Every field has a code-side default (DEFAULT_FLOW_SETTINGS), so switching
// a reel to the flow works before anyone opens this form.
model InstagramFlowSettings {
  id  String @id @default(auto()) @map("_id") @db.ObjectId
  key String @unique @default("default")

  // Off switches the whole flow back to plain text replies, without having
  // to un-tick every reel.
  isActive Boolean @default(true)

  // Step 1 — the opener, sent as the private reply to the comment.
  openerMessage     String
  openerButtonLabel String

  // Step 2 — the follow gate, sent when the check doesn't come back positive.
  // The check runs on the *tap*, not on the comment: tapping sends us a
  // message, which is exactly what lets Instagram resolve
  // is_user_follow_business for someone who has never messaged us.
  //
  // This switch is account-wide, not flow-only: on, it gates *every* path
  // that issues a link — reel replies and DM rules included — and a per-reel
  // or per-rule switch can only tighten it further (see decideLinkGate). It
  // is the one place "hand links to everyone" can be turned on, and it holds
  // even when the flow itself is switched off.
  requireFollow            Boolean @default(true)
  followMessage            String
  followButtonLabel        String
  // Sent when they tap "I'm following" but the check still says otherwise.
  stillNotFollowingMessage String
  // The "Visit profile" button. Blank drops the button — the flow still
  // works, people just have to find the profile themselves.
  profileUrl               String?
  profileButtonLabel       String

  // The publication gate. Building an invitation is never gated — the offer
  // is a free website, and a half-finished one nobody can share is worth
  // nothing. What following buys is circulation: with this on, an invitation
  // claimed through Instagram shows a follow-first screen to its guests
  // whenever its owner isn't following, and goes live again when they are.
  // Missing reads as on, so a settings row saved before this existed still
  // gates rather than failing to load at all.
  gateInvitations Boolean?
  // What that screen says. Blank uses DEFAULT_PAUSED_MESSAGE.
  pausedMessage   String?

  // Step 3 — the payoff: the edit link, so they can build the invitation.
  // Sent as one plain message. It carries no button on purpose — a link
  // button forces Instagram's card format, and a card can't hold more than
  // 80 characters of text, so anything longer arrives as two bubbles.
  // Supports {{link}} and {{username}}.
  linkMessage      String
  // Sent instead of linkMessage when this account already claimed a link.
  // The same edit link again, so they can pick up where they left off.
  duplicateMessage String

  // Step 4 — the card itself, sent when they publish it rather than when
  // they claim the link. Until an invitation is published there is no public
  // page to send, so the link that goes out on a tap is the editor and this
  // is the one guests can open. Missing reads as on. Supports {{link}}
  // (the public invitation) and {{username}}.
  notifyOnPublish  Boolean?
  publishedMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("instagram_flow_settings")
}

enum InstagramFlowStep {
  // Opener sent; waiting for the first tap.
  AWAITING_TAP
  // Follow gate sent; waiting for "I'm following".
  AWAITING_FOLLOW
  // Link delivered.
  COMPLETED
}

// Where one Instagram account has got to in the button flow. The taps
// themselves carry their own payload, so this is not what routes them — it
// is what lets someone who *types* "I'm following" instead of tapping be
// understood, and what shows an admin how many people are sitting at the
// follow gate rather than through it.
model InstagramFlowState {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  igUserId     String            @unique
  step         InstagramFlowStep
  username     String?
  // The reel whose comment started the flow, so the link claimed three taps
  // later still attributes to it. Not a relation: the flow outlives the
  // automation being edited or deleted, and a dangling id here only costs
  // the attribution, which is checked before it is used.
  automationId String?           @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("instagram_flow_states")
}

// ---------------------------------------------------------------------------
// Celebration form configuration
// ---------------------------------------------------------------------------

// An admin's overrides for one celebration's create form. `event-categories.ts`
// holds the catalogue — what a wedding calls its two name slots, which
// ceremonies it pre-fills — and this holds the parts of it that shouldn't
// need a deploy to change: the wording, which steps the wizard walks, and per
// field whether it is asked at all and whether it is required.
//
// Every column is optional and every list may be empty, because a row is a
// *partial* override: an empty one changes nothing, and one that renames a
// single label leaves the rest of the catalogue standing. A celebration with
// no row here behaves exactly as the code describes it, which is what keeps
// the two editable independently.
model EventCategoryConfig {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  // The catalogue slug this configures: "wedding", "birthday", ...
  slug String @unique

  // Off takes the celebration off the public "Get started" picker without
  // touching the invitations already made under it.
  isEnabled Boolean?

  label              String?
  tagline            String?
  primaryNameLabel   String?
  secondaryNameLabel String?
  // Whether the second name slot may be left blank — a birthday's host,
  // where a wedding's groom may not.
  secondaryOptional  Boolean?
  joiner             String?
  dateLabel          String?
  eventsLabel        String?
  familyBrideLabel   String?
  familyGroomLabel   String?

  // Empty means "use the catalogue's", not "offer none".
  defaultEvents   String[]
  familyRelations String[]
  // Wizard steps to walk, by key. Empty means the catalogue's default set.
  steps           String[]

  // Per-field rules: { [fieldKey]: { enabled, required, label } }. Missing
  // keys fall back to the defaults derived from the catalogue.
  fields Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("event_category_configs")
}

// ---------------------------------------------------------------------------
// Books: vendors, staff, and the priced order lines the admin reports read
// ---------------------------------------------------------------------------

// An outside supplier a job is bought from — the press that prints the cards,
// the studio that shoots the pre-wedding film, the courier that ships them.
// Kept as its own record rather than a free-text string on the order line so
// "vendor wise" can total a supplier across a year of jobs even after someone
// changes how they spell the name.
model Vendor {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  // Stable handle used by the reports and the CSV export, so a rename never
  // splits one supplier into two rows.
  slug     String  @unique
  // Free text on purpose: what a studio buys from outside changes faster than
  // an enum can be redeployed. "printing", "photography", "video", "courier".
  category String?

  contactName String?
  phone       String?
  email       String?
  notes       String?
  // Retired suppliers stay on the books: their past jobs are still part of
  // last year's profit. Off only takes them out of the pickers.
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@map("vendors")
}

// Someone who works the orders — a designer, a sales person, a support agent.
// Deliberately separate from `User`: most of the team never signs into the
// app, and the ones who do should not have to hold a login before their work
// can be credited to them. `userId` links the two where both exist.
model Employee {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  slug   String  @unique
  userId String? @unique @db.ObjectId

  // "designer", "sales", "support" — free text for the same reason a
  // vendor's category is.
  role     String?
  phone    String?
  email    String?
  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@map("employees")
}

// What kind of thing was sold. THEME/PDF_THEME/VIDEO_TEMPLATE/MUSIC line up
// with the catalogue an admin already curates, so an item-wise report can
// name the exact design that earned the money; the rest cover work that has
// no catalogue row (a print run, a delivery, a bespoke service).
enum OrderItemKind {
  THEME
  PDF_THEME
  VIDEO_TEMPLATE
  MUSIC
  PRINT
  SERVICE
  ADDON
  OTHER
}

// One priced line of one order. This is the single fact table behind every
// admin report: item wise groups it by `itemKey`, order wise by
// `invitationId`, vendor wise by `vendorId`, employee wise by `employeeId`,
// and daily/weekly/monthly by `occurredAt`. Profit is revenue minus cost on
// the same row, so no report has to join two sources to subtract them.
//
// Money is stored in minor units (paise for INR, cents for USD) as integers.
// Floating-point rupees drift once you sum a few thousand of them, and a
// report whose total disagrees with the sum of its own rows is worse than no
// report.
model OrderItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // The order. An invitation is the unit a studio actually bills for, so it
  // is what "order wise" counts.
  invitationId String        @db.ObjectId
  kind         OrderItemKind @default(SERVICE)

  // How the item-wise report groups. For a catalogue kind this is the
  // catalogue record's id; for everything else it is a slug the admin types
  // once and reuses ("premium-card-print"). `itemName` is only the label —
  // renaming an item never moves its history to a new row.
  itemKey  String
  itemName String

  quantity  Int    @default(1)
  // Charged to the couple, per unit, in minor units.
  unitPrice Int    @default(0)
  // Paid out for it, per unit, in minor units. Zero is a real answer — work
  // done in-house costs nothing outside — so it is not nullable.
  unitCost  Int    @default(0)
  currency  String @default("INR")

  vendorId   String? @db.ObjectId
  employeeId String? @db.ObjectId

  // The business date the line belongs to, which is not always the date the
  // row was typed in: a job booked on the 31st and entered on the 2nd belongs
  // to the month it was booked. Every period bucket reads this, never
  // `createdAt`.
  occurredAt DateTime @default(now())
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  vendor     Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([invitationId])
  @@index([occurredAt])
  @@index([vendorId])
  @@index([employeeId])
  @@index([itemKey])
  @@map("order_items")
}
