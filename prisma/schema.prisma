// AI Wedding Invitation Studio — database schema (MongoDB)
// Run `npx prisma db push` after setting DATABASE_URL to apply this.
// MongoDB is schema-less — there is no `prisma migrate`, only `db push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth.js / Auth.js v5 — @auth/prisma-adapter shape)
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // set for credentials sign-up; null for OAuth-only users
  role          UserRole  @default(USER)
  // Optional (not defaulted) so existing Mongo documents without this field
  // still read fine — treat missing/null as active everywhere it's read.
  isActive      Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  invitations   Invitation[]
  subscription  Subscription?
  analyticsHits AnalyticsEvent[]

  @@map("users")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  userId               String             @unique @db.ObjectId
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Theming / template catalog (admin-managed, invitation-agnostic)
// ---------------------------------------------------------------------------

// WEBSITE themes drive the live invitation site; PDF themes drive the
// print/"Download PDF" stylesheet. Same shape (palette, fonts, section
// order) reused across both surfaces, filtered by type wherever a picker
// only wants one of them.
enum ThemeType {
  WEBSITE
  PDF
}

model Theme {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  type           ThemeType @default(WEBSITE)
  name           String
  slug           String    @unique
  description    String?
  previewImage   String?
  category       String    @default("classic") // "traditional" | "modern" | "fusion" | "minimal" | "classic"
  // Which celebration this design is written for — "wedding", "birthday",
  // "housewarming"... See src/lib/event-categories.ts. A theme only ever
  // shows up in the picker for its own category.
  eventCategory  String    @default("wedding")
  // Default copy this design ships with (headline, invitation letter, thank
  // you...), used when the couple asks for no AI copy. Shape: the
  // EventCategoryContent type. Null falls back to the category's own copy.
  content        Json?
  colorPalette   Json // { primary, secondary, accent, background, foreground }
  fontPairing    Json // { display, body, script }
  decorAssets    Json? // preset decoration config (petals, sparkles, motifs...)
  isPremium      Boolean   @default(false)
  sortOrder      Int       @default(0)
  // Envelope-open moment: admin picks "ANIMATION" (coded burst only) or
  // "VIDEO" (a short muted clip, preloaded and layered over the coded
  // burst once ready — falls back to the coded burst if it isn't ready
  // in time, so the reveal never blocks on the network). WEBSITE themes only.
  revealMode     String    @default("ANIMATION") // "ANIMATION" | "VIDEO"
  revealVideoUrl String?

  templates      Template[]
  colorways      ThemeColorway[]
  invitations    Invitation[]    @relation("InvitationWebsiteTheme")
  pdfInvitations Invitation[]    @relation("InvitationPdfTheme")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("themes")
}

// A theme is a design — layout, fonts, ornament, reveal — and a colourway is
// one of the colour schemes it ships in. "Royal" in maroon-and-gold and
// "Royal" in emerald are the same design, so they share a Theme and differ
// only here. The theme's own `colorPalette` remains its default colourway.
model ThemeColorway {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  themeId      String  @db.ObjectId
  name         String // "Maroon & Gold", "Emerald", "Blush"
  slug         String
  colorPalette Json // { primary, secondary, accent, background, foreground }
  previewImage String?
  sortOrder    Int     @default(0)

  theme       Theme        @relation(fields: [themeId], references: [id], onDelete: Cascade)
  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([themeId, slug])
  @@map("theme_colorways")
}

model Template {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String  @unique
  description  String?
  previewImage String?
  themeId      String  @db.ObjectId
  sectionOrder Json // default ordered list of SectionType strings (WEBSITE themes)
  // Multi-page PDF layout (PDF themes only): PdfTemplatePage[] — each page a
  // background image/color plus positioned, field-bound text placeholders.
  // See src/lib/validations/pdf-template.ts for the shape.
  pages        Json?
  isPremium    Boolean @default(false)

  theme       Theme        @relation(fields: [themeId], references: [id])
  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("templates")
}

// Gemini video "themes": a reusable prompt template + style/aspect ratio
// preset, admin-managed the same way website/PDF themes are.
model VideoTemplate {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String  @unique
  description     String?
  previewImage    String?
  aspectRatio     String  @default("9:16") // "9:16" | "16:9" | "1:1"
  durationSeconds Int     @default(15)
  // Prompt sent to Gemini's video model. Supports {{brideName}}, {{groomName}},
  // {{weddingDate}}, {{venueName}}, {{style}} placeholders, filled in from the
  // invitation's own captured details at generation time.
  promptTemplate  String
  styleKeywords   Json? // string[] of mood/style keywords appended to the prompt
  // "auto" resolves to the best video model the generating key can
  // actually reach; a pinned ID is still honoured when it's available.
  geminiModel     String  @default("auto")
  isPremium       Boolean @default(false)
  sortOrder       Int     @default(0)

  invitations Invitation[]
  videos      InvitationVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("video_templates")
}

model MusicTrack {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String   @unique
  artist     String?
  url        String
  durationMs Int?
  mood       String? // e.g. "romantic", "upbeat", "traditional"
  isPremium  Boolean  @default(false)
  // Auto-assigned when a couple doesn't pick a track. Optional (not defaulted)
  // so existing tracks without this field still read fine — only one track
  // should be true at a time; enforced in upsertMusicTrackAction, not here.
  isDefault  Boolean?

  invitations Invitation[]

  createdAt DateTime @default(now())

  @@map("music_tracks")
}

// ---------------------------------------------------------------------------
// Invitation (the core object the wizard/builder/renderer all operate on)
// ---------------------------------------------------------------------------

enum InvitationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InvitationLanguage {
  EN
  HI
  MR
  GU
  TA
  TE
  ES
  FR
}

model Invitation {
  id     String           @id @default(auto()) @map("_id") @db.ObjectId
  // Optional: guest invitations (created from the public "Get started" flow,
  // before any WhatsApp-verified phone is linked) have no user account.
  userId String?          @db.ObjectId
  slug   String           @unique
  status InvitationStatus @default(DRAFT)

  // Which kind of celebration this is — "wedding", "birthday", "naming"...
  // Decides what the two name slots below mean, what copy is written, and
  // what the PDF's cover says. See src/lib/event-categories.ts.
  eventCategory String @default("wedding")

  // Guest-flow ownership. `draftSecretHash` authorizes edits to an
  // unpublished guest draft (its raw value lives only in an httpOnly
  // cookie on the creator's browser). Once the owner verifies a WhatsApp
  // OTP, a PhoneLink takes over as the durable, cross-device "login".
  draftSecretHash String?
  isDemo          Boolean @default(false)

  // The two name slots. For a wedding they're the couple; for a birthday
  // they're the birthday star and whoever is hosting; for a housewarming
  // the family name and the host. `eventCategory` decides which, and how
  // they're joined when printed.
  brideName  String
  bridePhoto String?
  groomName  String
  groomPhoto String?

  // Core details
  weddingDate   DateTime
  venueName     String?
  venueAddress  String?
  googleMapsUrl String?
  customMessage String?
  language      InvitationLanguage @default(EN)
  // Culture, asked first in the wizard so the ceremony list can be
  // pre-filled with the rituals that tradition actually observes.
  religion      String?
  caste         String?
  // Extra text for the PDF only (e.g. a formal invitation letter) — not
  // shown on the website, bindable to a placeholder on a PDF template page.
  pdfExtraText  String?

  // Design
  themeId          String? @db.ObjectId // WEBSITE-type Theme
  templateId       String? @db.ObjectId
  // Optional PDF-type Theme override for the downloadable PDF — falls back
  // to `theme` (the website theme's palette) when unset.
  pdfThemeId       String? @db.ObjectId
  // Last video template picked/used for Gemini video generation — surfaced
  // as the default selection next time the couple regenerates one.
  videoTemplateId  String? @db.ObjectId
  // Couple's own Gemini API key (from Google AI Studio), used instead of the
  // platform's GEMINI_API_KEY when set. Never rendered back to the client —
  // forms only report whether one is configured.
  geminiApiKey     String?
  fontPairing      Json? // override of theme default, { display, body, script }
  // Which of the theme's colourways was chosen. The resolved palette is
  // copied into `colorPalette` on save, so rendering never has to know
  // colourways exist — this only records the choice for the pickers.
  colorwayId       String? @db.ObjectId
  colorPalette     Json? // resolved palette: colourway, or a manual override
  musicTrackId     String? @db.ObjectId
  customMusicUrl   String? // couple's own uploaded audio — takes priority over musicTrackId when set
  galleryAnimation String  @default("fade") // "fade" | "slide" | "zoom" | "flip" | "blur" — gallery photo reveal style
  sectionConfig    Json // [{ id, type, visible, locked, order }] — drives the drag-drop builder

  // AI + content
  aiGenerated     Boolean @default(false)
  aiGeneratedCopy Json? // { heroHeadline, heroSubline, invitationLetter, hashtags, ... }

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme         Theme?         @relation("InvitationWebsiteTheme", fields: [themeId], references: [id])
  colorway      ThemeColorway? @relation(fields: [colorwayId], references: [id])
  pdfTheme      Theme?         @relation("InvitationPdfTheme", fields: [pdfThemeId], references: [id])
  template      Template?      @relation(fields: [templateId], references: [id])
  music         MusicTrack?    @relation(fields: [musicTrackId], references: [id])
  videoTemplate VideoTemplate? @relation(fields: [videoTemplateId], references: [id])

  events          Event[]
  familyMembers   FamilyMember[]
  guests          Guest[]
  rsvps           Rsvp[]
  media           Media[]
  analyticsEvents AnalyticsEvent[]
  deployment      Deployment?
  phoneLink       PhoneLink?
  instagramLink   InstagramLink?
  videos          InvitationVideo[]

  @@index([userId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Guest publish flow
// ---------------------------------------------------------------------------

// Established directly at publish time (no OTP round-trip) from a phone
// number the couple provides. Both `phone` and `invitationId` are unique,
// so this is the enforcement point for "one mobile number, one invitation":
// a phone can appear in at most one row, an invitation can be linked to at
// most one phone. `editTokenHash` backs the pre-logged WhatsApp link sent
// to the owner for future edits.
model PhoneLink {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  phone         String   @unique
  invitationId  String   @unique @db.ObjectId
  editTokenHash String   @unique
  verifiedAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("phone_links")
}

model Event {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  invitationId  String   @db.ObjectId
  name          String // e.g. "Mehendi", "Haldi", "Wedding"
  date          DateTime
  time          String?
  venueName     String?
  address       String?
  googleMapsUrl String?
  dressCode     String?
  accentColor   String?
  tagline       String? // short italic line under the event name, e.g. "The groom's royal procession begins!"
  order         Int      @default(0)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("events")
}

enum FamilySide {
  BRIDE
  GROOM
}

model FamilyMember {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  invitationId String     @db.ObjectId
  side         FamilySide
  relation     String // "Father", "Mother", "Sister", ...
  name         String
  photo        String?
  order        Int        @default(0)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("family_members")
}

model Guest {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  invitationId String    @db.ObjectId
  name         String
  email        String?
  phone        String?
  group        String? // e.g. "Bride's side", "Groom's college friends"
  inviteToken  String    @unique @default(cuid())
  viewedAt     DateTime? // set the first time this guest opens their personalized link

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  rsvp       Rsvp?

  createdAt DateTime @default(now())

  @@index([invitationId])
  @@map("guests")
}

enum RsvpStatus {
  ACCEPTED
  DECLINED
  MAYBE
}

model Rsvp {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  invitationId   String     @db.ObjectId
  guestId        String?    @unique @db.ObjectId
  guestName      String
  email          String?
  phone          String?
  status         RsvpStatus
  guestCount     Int        @default(1)
  foodPreference String?
  comment        String?

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invitationId])
  @@map("rsvps")
}

enum MediaType {
  IMAGE
  VIDEO
}

model Media {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  invitationId String    @db.ObjectId
  url          String
  cloudinaryId String?
  type         MediaType @default(IMAGE)
  width        Int?
  height       Int?
  blurDataUrl  String?
  caption      String?
  order        Int       @default(0)
  isAuto       Boolean   @default(false) // filled by the "use automatic photos" fallback, not uploaded by the couple

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([invitationId])
  @@map("media")
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

enum AnalyticsEventType {
  VIEW
  SHARE
  RSVP_SUBMIT
  CLICK_MAPS
  CLICK_REGISTRY
  CLICK_INSTAGRAM
}

model AnalyticsEvent {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  invitationId String             @db.ObjectId
  userId       String?            @db.ObjectId
  type         AnalyticsEventType
  country      String?
  device       String? // "mobile" | "tablet" | "desktop"
  referrer     String?
  path         String?

  createdAt DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([invitationId])
  @@index([type])
  @@map("analytics_events")
}

// ---------------------------------------------------------------------------
// Deployment
// ---------------------------------------------------------------------------

enum DeploymentStatus {
  PENDING
  BUILDING
  DEPLOYED
  FAILED
}

model Deployment {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  invitationId    String           @unique @db.ObjectId
  status          DeploymentStatus @default(PENDING)
  url             String?
  customDomain    String?
  vercelProjectId String?
  vercelDeployId  String?
  error           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("deployments")
}

// ---------------------------------------------------------------------------
// Gemini video generation
// ---------------------------------------------------------------------------

enum VideoJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// One row per generation attempt (couples can regenerate with a different
// template), so history stays visible instead of being overwritten.
model InvitationVideo {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  invitationId      String         @db.ObjectId
  videoTemplateId   String         @db.ObjectId
  status            VideoJobStatus @default(PENDING)
  // The fully-resolved prompt sent to Gemini, built from the invitation's
  // own captured details (names, date, venue, theme colors) + the template.
  prompt            String
  videoUrl          String?
  geminiOperationId String?
  // The model the job actually ran on — not always the template's, since
  // an unreachable pinned model falls back to one the key can reach.
  geminiModel       String?
  error             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation    Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  videoTemplate VideoTemplate @relation(fields: [videoTemplateId], references: [id])

  @@index([invitationId])
  @@map("invitation_videos")
}

// ---------------------------------------------------------------------------
// Instagram comment-to-DM automation
// ---------------------------------------------------------------------------

// One automation rule per Instagram post/reel. Without a rule for the media
// a comment arrived on, the webhook does nothing — automation is opt-in per
// reel rather than replying to every "FREE" anywhere on the account.
model InstagramAutomation {
  id                  String  @id @default(auto()) @map("_id") @db.ObjectId
  // Instagram media ID the rule applies to, from the comment webhook's
  // value.media.id. Unique so one reel has exactly one rule.
  mediaId             String  @unique
  // Admin-facing name so reels are recognisable in the dashboard.
  label               String
  permalink           String?
  triggerWord         String
  // Reply sent on a first match. Supports {{link}} and {{username}}.
  replyMessage        String
  // Reply sent when this commenter already claimed this reel's link.
  duplicateMessage    String
  // Gate the link behind following the account. The follow check is
  // best-effort (see InstagramProfile) and fails closed: a status Instagram
  // won't resolve is treated as "not following", because it won't resolve
  // for most first-time commenters and failing open handed the link to
  // everyone. They're asked to follow and comment again instead.
  requireFollow       Boolean @default(false)
  notFollowingMessage String?
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads InstagramLead[]
  logs  InstagramCommentLog[]

  @@map("instagram_automations")
}

// Tracks which Instagram accounts have already received their access link
// for a given reel, enforcing one link per account per automation. Written
// only after the send actually succeeds.
// The Instagram equivalent of PhoneLink, and the identity spine of the
// comment-to-DM flow: it binds one Instagram account to exactly one
// invitation and backs the pre-logged /e/<token> link sent by DM. Both
// `igUserId` and `invitationId` are unique, so an Instagram account owns at
// most one invitation — which is what makes "one website, one PDF, one video
// per Instagram user" enforceable at all.
model InstagramLink {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  igUserId      String   @unique
  username      String?
  invitationId  String   @unique @db.ObjectId
  editTokenHash String   @unique
  createdAt     DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("instagram_links")
}

model InstagramLead {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  // Optional so rows created before per-reel automations still read; those
  // legacy rows simply never match a (user, automation) pair again.
  automationId String?  @db.ObjectId
  igUserId     String
  commentId    String
  link         String
  createdAt    DateTime @default(now())

  automation InstagramAutomation? @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([igUserId, automationId])
  @@map("instagram_leads")
}

enum InstagramCommentOutcome {
  REPLY_SENT
  DUPLICATE_SKIPPED
  TRIGGER_NOT_MATCHED
  NO_AUTOMATION
  AUTOMATION_INACTIVE
  // Instagram confirmed they don't follow the account.
  NOT_FOLLOWING
  // Instagram wouldn't say either way, so the followers-only gate held the
  // link back. Distinct from NOT_FOLLOWING so an admin can see whether the
  // gate is turning people away on real answers or on unresolved checks.
  FOLLOW_UNVERIFIED
  SEND_FAILED
}

// Cached follower status per commenter. Instagram has no "does X follow me"
// lookup for arbitrary users — only the messaging User Profile endpoint's
// is_user_follow_business — so results are cached here to avoid re-querying
// on every comment. Only positive results are trusted for the cache window:
// someone told to follow first will follow and immediately re-comment, so a
// cached "not following" would keep locking them out. Unresolved checks are
// not stored at all — the private reply sent on one opens a conversation,
// which is often exactly what lets the next check resolve.
model InstagramProfile {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  igUserId   String   @unique
  username   String?
  isFollower Boolean
  checkedAt  DateTime @default(now())

  @@map("instagram_profiles")
}

// Every comment the webhook processes, matched or not, so the admin
// dashboard can show what came in per reel and what was replied.
model InstagramCommentLog {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  automationId String?                 @db.ObjectId
  mediaId      String
  commentId    String
  igUserId     String?
  username     String?
  commentText  String
  outcome      InstagramCommentOutcome
  replyText    String?
  error        String?
  createdAt    DateTime                @default(now())

  automation InstagramAutomation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@index([mediaId])
  @@index([createdAt])
  // Read on every incoming comment to spot a webhook Meta re-delivered.
  // Deliberately not unique: existing rows predate the check and may repeat.
  @@index([commentId])
  @@map("instagram_comment_logs")
}

// ---------------------------------------------------------------------------
// Instagram DM automation
// ---------------------------------------------------------------------------

enum InstagramDmMatchType {
  // The whole message, trimmed, equals the keyword.
  EXACT
  // The keyword appears anywhere in the message.
  CONTAINS
  // The message opens with the keyword.
  STARTS_WITH
  // No keyword — matches anything. The deliberate catch-all, so "reply to
  // every DM" stays possible but has to be switched on rather than assumed.
  ANY
}

// One rule per kind of incoming DM. Like the per-reel comment automations,
// DM replies are opt-in: a message matching no active rule is logged for the
// dashboard and left for a human, instead of every DM getting the same
// canned answer.
model InstagramDmRule {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  label String

  matchType InstagramDmMatchType @default(CONTAINS)
  // Ignored (and stored null) when matchType is ANY.
  keyword   String?

  // Reply text. Supports {{username}}, plus {{link}} when issueLink is on.
  replyMessage     String
  // Hand the sender their invitation link, the same one the comment
  // automations issue, so a DM can carry the whole flow on its own.
  issueLink        Boolean @default(false)
  // Sent instead of replyMessage when this sender already has a link.
  duplicateMessage String?

  // Higher wins. Rules are compared in priority order and the first match
  // replies, so a specific keyword can be placed above a catch-all.
  priority Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs InstagramMessageLog[]

  @@map("instagram_dm_rules")
}

enum InstagramDmOutcome {
  REPLY_SENT
  DUPLICATE_REPLY_SENT
  // Nothing matched, so nothing was sent — the quiet default.
  NO_RULE_MATCHED
  DATA_DELETED
  DATA_DELETE_FAILED
  SEND_FAILED
}

// Every inbound DM the webhook processes, replied to or not, so an admin can
// see what people actually send and write rules for the messages that need
// one.
model InstagramMessageLog {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  ruleId      String?            @db.ObjectId
  // Meta's message id (mid). Optional because a payload can omit it; when
  // present it is what stops a re-delivered webhook sending a second reply.
  messageId   String?
  igUserId    String
  username    String?
  messageText String
  outcome     InstagramDmOutcome
  replyText   String?
  error       String?
  createdAt   DateTime           @default(now())

  rule InstagramDmRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([igUserId])
  @@index([createdAt])
  // Read on every inbound message to spot a webhook Meta re-delivered.
  @@index([messageId])
  @@map("instagram_message_logs")
}
