// AI Wedding Invitation Studio — database schema (MongoDB)
// Run `npx prisma db push` after setting DATABASE_URL to apply this.
// MongoDB is schema-less — there is no `prisma migrate`, only `db push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth.js / Auth.js v5 — @auth/prisma-adapter shape)
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // set for credentials sign-up; null for OAuth-only users
  role          UserRole  @default(USER)
  // Optional (not defaulted) so existing Mongo documents without this field
  // still read fine — treat missing/null as active everywhere it's read.
  isActive      Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  invitations   Invitation[]
  subscription  Subscription?
  analyticsHits AnalyticsEvent[]

  @@map("users")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  userId               String             @unique @db.ObjectId
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Theming / template catalog (admin-managed, invitation-agnostic)
// ---------------------------------------------------------------------------

model Theme {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String  @unique
  description  String?
  previewImage String?
  category     String  @default("classic") // "traditional" | "modern" | "fusion" | "minimal" | "classic"
  colorPalette Json // { primary, secondary, accent, background, foreground }
  fontPairing  Json // { display, body, script }
  decorAssets  Json? // preset decoration config (petals, sparkles, motifs...)
  isPremium    Boolean @default(false)
  sortOrder    Int     @default(0)
  // Envelope-open moment: admin picks "ANIMATION" (coded burst only) or
  // "VIDEO" (a short muted clip, preloaded and layered over the coded
  // burst once ready — falls back to the coded burst if it isn't ready
  // in time, so the reveal never blocks on the network).
  revealMode     String  @default("ANIMATION") // "ANIMATION" | "VIDEO"
  revealVideoUrl String?

  templates   Template[]
  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("themes")
}

model Template {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String  @unique
  description  String?
  previewImage String?
  themeId      String  @db.ObjectId
  sectionOrder Json // default ordered list of SectionType strings
  isPremium    Boolean @default(false)

  theme       Theme        @relation(fields: [themeId], references: [id])
  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("templates")
}

model MusicTrack {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  title      String  @unique
  artist     String?
  url        String
  durationMs Int?
  mood       String? // e.g. "romantic", "upbeat", "traditional"
  isPremium  Boolean @default(false)
  // Auto-assigned when a couple doesn't pick a track. Optional (not defaulted)
  // so existing tracks without this field still read fine — only one track
  // should be true at a time; enforced in upsertMusicTrackAction, not here.
  isDefault  Boolean?

  invitations Invitation[]

  createdAt DateTime @default(now())

  @@map("music_tracks")
}

// ---------------------------------------------------------------------------
// Invitation (the core object the wizard/builder/renderer all operate on)
// ---------------------------------------------------------------------------

enum InvitationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InvitationLanguage {
  EN
  HI
  MR
  GU
  TA
  TE
  ES
  FR
}

model Invitation {
  id     String           @id @default(auto()) @map("_id") @db.ObjectId
  // Optional: guest invitations (created from the public "Get started" flow,
  // before any WhatsApp-verified phone is linked) have no user account.
  userId String?          @db.ObjectId
  slug   String           @unique
  status InvitationStatus @default(DRAFT)

  // Guest-flow ownership. `draftSecretHash` authorizes edits to an
  // unpublished guest draft (its raw value lives only in an httpOnly
  // cookie on the creator's browser). Once the owner verifies a WhatsApp
  // OTP, a PhoneLink takes over as the durable, cross-device "login".
  draftSecretHash String?
  isDemo          Boolean  @default(false)

  // Couple
  brideName  String
  bridePhoto String?
  groomName  String
  groomPhoto String?

  // Core details
  weddingDate   DateTime
  venueName     String?
  venueAddress  String?
  googleMapsUrl String?
  customMessage String?
  language      InvitationLanguage @default(EN)

  // Design
  themeId          String? @db.ObjectId
  templateId       String? @db.ObjectId
  fontPairing      Json? // override of theme default, { display, body, script }
  colorPalette     Json? // override of theme default
  musicTrackId     String? @db.ObjectId
  customMusicUrl   String? // couple's own uploaded audio — takes priority over musicTrackId when set
  galleryAnimation String  @default("fade") // "fade" | "slide" | "zoom" | "flip" | "blur" — gallery photo reveal style
  sectionConfig    Json // [{ id, type, visible, locked, order }] — drives the drag-drop builder

  // AI + content
  aiGenerated     Boolean @default(false)
  aiGeneratedCopy Json? // { heroHeadline, heroSubline, invitationLetter, hashtags, ... }

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme    Theme?      @relation(fields: [themeId], references: [id])
  template Template?   @relation(fields: [templateId], references: [id])
  music    MusicTrack? @relation(fields: [musicTrackId], references: [id])

  events          Event[]
  familyMembers   FamilyMember[]
  guests          Guest[]
  rsvps           Rsvp[]
  media           Media[]
  analyticsEvents AnalyticsEvent[]
  deployment      Deployment?
  phoneLink       PhoneLink?
  otpChallenges   OtpChallenge[]

  @@index([userId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Guest publish flow — WhatsApp OTP verification
// ---------------------------------------------------------------------------

// Created once an OTP challenge succeeds. Both `phone` and `invitationId`
// are unique, so this is the enforcement point for "one mobile number, one
// invitation": a phone can appear in at most one row, an invitation can be
// linked to at most one phone. `editTokenHash` backs the pre-logged
// WhatsApp link sent to the owner for future edits.
model PhoneLink {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  phone         String   @unique
  invitationId  String   @unique @db.ObjectId
  editTokenHash String   @unique
  verifiedAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("phone_links")
}

model OtpChallenge {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  invitationId String   @db.ObjectId
  phone       String
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, phone])
  @@map("otp_challenges")
}

model Event {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  invitationId  String   @db.ObjectId
  name          String // e.g. "Mehendi", "Haldi", "Wedding"
  date          DateTime
  time          String?
  venueName     String?
  address       String?
  googleMapsUrl String?
  dressCode     String?
  accentColor   String?
  tagline       String? // short italic line under the event name, e.g. "The groom's royal procession begins!"
  order         Int      @default(0)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("events")
}

enum FamilySide {
  BRIDE
  GROOM
}

model FamilyMember {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  invitationId String     @db.ObjectId
  side         FamilySide
  relation     String // "Father", "Mother", "Sister", ...
  name         String
  photo        String?
  order        Int        @default(0)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("family_members")
}

model Guest {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  invitationId String    @db.ObjectId
  name         String
  email        String?
  phone        String?
  group        String? // e.g. "Bride's side", "Groom's college friends"
  inviteToken  String    @unique @default(cuid())
  viewedAt     DateTime? // set the first time this guest opens their personalized link

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  rsvp       Rsvp?

  createdAt DateTime @default(now())

  @@index([invitationId])
  @@map("guests")
}

enum RsvpStatus {
  ACCEPTED
  DECLINED
  MAYBE
}

model Rsvp {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  invitationId   String     @db.ObjectId
  guestId        String?    @unique @db.ObjectId
  guestName      String
  email          String?
  phone          String?
  status         RsvpStatus
  guestCount     Int        @default(1)
  foodPreference String?
  comment        String?

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invitationId])
  @@map("rsvps")
}

enum MediaType {
  IMAGE
  VIDEO
}

model Media {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  invitationId String    @db.ObjectId
  url          String
  cloudinaryId String?
  type         MediaType @default(IMAGE)
  width        Int?
  height       Int?
  blurDataUrl  String?
  caption      String?
  order        Int       @default(0)
  isAuto       Boolean   @default(false) // filled by the "use automatic photos" fallback, not uploaded by the couple

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([invitationId])
  @@map("media")
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

enum AnalyticsEventType {
  VIEW
  SHARE
  RSVP_SUBMIT
  CLICK_MAPS
  CLICK_REGISTRY
  CLICK_INSTAGRAM
}

model AnalyticsEvent {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  invitationId String             @db.ObjectId
  userId       String?            @db.ObjectId
  type         AnalyticsEventType
  country      String?
  device       String? // "mobile" | "tablet" | "desktop"
  referrer     String?
  path         String?

  createdAt DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([invitationId])
  @@index([type])
  @@map("analytics_events")
}

// ---------------------------------------------------------------------------
// Deployment
// ---------------------------------------------------------------------------

enum DeploymentStatus {
  PENDING
  BUILDING
  DEPLOYED
  FAILED
}

model Deployment {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  invitationId    String           @unique @db.ObjectId
  status          DeploymentStatus @default(PENDING)
  url             String?
  customDomain    String?
  vercelProjectId String?
  vercelDeployId  String?
  error           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("deployments")
}
