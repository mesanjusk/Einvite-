# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local dev: docker compose up -d db   (see docker-compose.yml)
DATABASE_URL="postgresql://studio:studio@localhost:5432/wedding_studio?schema=public"

# ---------------------------------------------------------------------------
# Auth.js (required)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional — enables "Sign in with Google"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Email (Resend) — magic-link sign-in + RSVP notifications
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="AI Wedding Invitation Studio <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional alternate upload path
UPLOADTHING_TOKEN=""

# ---------------------------------------------------------------------------
# AI generation (copywriting wizard)
# ---------------------------------------------------------------------------
# Either works — Anthropic is used first if both are set.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# Billing (Stripe) — see README "Billing" section before enabling in prod
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_PREMIUM=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# Deployment (one-click "Deploy" from the dashboard)
# ---------------------------------------------------------------------------
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
