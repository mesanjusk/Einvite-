# ---------------------------------------------------------------------------
# Database (required) — MongoDB
# ---------------------------------------------------------------------------
# Local dev: docker compose up -d db   (see docker-compose.yml — starts a
# single-node replica set, which Prisma's MongoDB connector requires)
# DATABASE_URL="mongodb://localhost:27017/wedding_studio?replicaSet=rs0"
#
# Production (MongoDB Atlas or similar):
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/wedding_studio?retryWrites=true&w=majority"

# ---------------------------------------------------------------------------
# Re-seeding the database (optional — not needed for the first seed)
# ---------------------------------------------------------------------------
# Visiting /api/admin/seed on a fresh deploy loads themes/templates/music
# automatically — no setup needed, it only ever writes when the database is
# empty. Set SEED_SECRET and pass ?secret=<value> to force a re-run later
# (e.g. after editing src/lib/seed-data.ts) once the database is no longer
# empty.
SEED_SECRET=""

# ---------------------------------------------------------------------------
# Auth.js (required)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional — enables "Sign in with Google"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Email (Resend) — magic-link sign-in + RSVP notifications
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="AI Wedding Invitation Studio <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# WhatsApp (Meta Cloud API) — publish OTP + pre-logged edit link
# ---------------------------------------------------------------------------
# Without these, the public "Get started" flow still works end to end: the
# OTP is logged to the server console and shown on-screen in the publish
# dialog instead of being texted, so it stays testable in local dev.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional alternate upload path
UPLOADTHING_TOKEN=""

# ---------------------------------------------------------------------------
# AI generation (copywriting wizard)
# ---------------------------------------------------------------------------
# Either works — Anthropic is used first if both are set.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# AI video generation (Gemini/Veo invitation teasers)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""

# ---------------------------------------------------------------------------
# Billing (Stripe) — see README "Billing" section before enabling in prod
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_PREMIUM=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# Deployment (one-click "Deploy" from the dashboard)
# ---------------------------------------------------------------------------
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# ---------------------------------------------------------------------------
# Instagram/Facebook webhooks (Meta Graph API) — /api/webhooks/instagram
# ---------------------------------------------------------------------------
# Arbitrary string you choose and enter as the verify token when configuring
# the webhook in the Meta App Dashboard.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""
# From the Meta App Dashboard — Settings > Basic > App Secret. Used to verify
# the x-hub-signature-256 header on incoming webhook events.
META_APP_SECRET=""
# Long-lived access token for the connected Instagram account, generated in
# the Meta developer console. Used to call the Instagram Send API (private
# comment replies + DMs) from the webhook handler.
IG_ACCESS_TOKEN=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Admin access and reports
# ---------------------------------------------------------------------------
# Which user groups grant admin, comma-separated, matched against the
# `usergroups` collection. Defaults to "Admin User" alone. Note that nothing
# is matched on the word "admin" — "Office Admin" is an ordinary group unless
# it is named here.
ADMIN_USER_GROUPS="Admin User"
# Set to "off" once every admin account sits in an admin group, to stop the
# legacy `role: ADMIN` column granting access on its own. The Users screen
# says how many accounts still depend on it.
ADMIN_LEGACY_ROLE=""
# Which timezone the admin reports bucket days, weeks and months by, as
# minutes east of UTC. Defaults to IST (+05:30). Leave unset unless the
# business runs somewhere else.
REPORTS_UTC_OFFSET_MINUTES=""
