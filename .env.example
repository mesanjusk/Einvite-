# ---------------------------------------------------------------------------
# Database (required) — MongoDB
# ---------------------------------------------------------------------------
# Local dev: docker compose up -d db   (see docker-compose.yml — starts a
# single-node replica set, which Prisma's MongoDB connector requires)
# DATABASE_URL="mongodb://localhost:27017/wedding_studio?replicaSet=rs0"
#
# Production (MongoDB Atlas or similar):
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/wedding_studio?retryWrites=true&w=majority"

# ---------------------------------------------------------------------------
# Re-seeding the database (optional — not needed for the first seed)
# ---------------------------------------------------------------------------
# Visiting /api/admin/seed on a fresh deploy loads themes/templates/music
# automatically — no setup needed, it only ever writes when the database is
# empty. Set SEED_SECRET and pass ?secret=<value> to force a re-run later
# (e.g. after editing src/lib/seed-data.ts) once the database is no longer
# empty.
SEED_SECRET=""

# ---------------------------------------------------------------------------
# Auth.js (required)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional — enables "Sign in with Google"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Email (Resend) — magic-link sign-in + RSVP notifications
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="AI Wedding Invitation Studio <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional alternate upload path
UPLOADTHING_TOKEN=""

# ---------------------------------------------------------------------------
# AI generation (copywriting wizard)
# ---------------------------------------------------------------------------
# Either works — Anthropic is used first if both are set.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# Billing (Stripe) — see README "Billing" section before enabling in prod
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_PREMIUM=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# Deployment (one-click "Deploy" from the dashboard)
# ---------------------------------------------------------------------------
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
